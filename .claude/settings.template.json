{
  "_comment": "このファイルはテンプレート。セットアップ時に {{HUB_PATH}}（このリポジトリの絶対パス）と {{PYTHON_CMD}}（python3 または python。Windowsは通常 python）を実際の値に置換して .claude/settings.json として保存する（Claudeがセットアップ中に自動でやる）",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_CMD}} {{HUB_PATH}}/dashboard/log_hook.py pre_tool"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_CMD}} {{HUB_PATH}}/dashboard/log_hook.py post_tool"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_CMD}} {{HUB_PATH}}/scripts/claude_md_sync_hook.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_CMD}} {{HUB_PATH}}/dashboard/log_hook.py stop"
          }
        ]
      }
    ]
  }
}
